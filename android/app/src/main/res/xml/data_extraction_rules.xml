<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+. Only the letters database is backed up or moved to a new
  device; flutter_secure_storage's data (the draft) is left out because its
  Keystore key doesn't survive a restore (docs/ARCHITECTURE.md).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/laternote.sqlite" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/laternote.sqlite" />
    </device-transfer>
</data-extraction-rules>
