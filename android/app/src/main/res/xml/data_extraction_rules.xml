<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+: allowBackup="false" already disables cloud backup; this also
  blocks device-to-device transfer, so a future allowBackup flip can't
  silently move session/refresh tokens.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
