<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup on Android 11 and below. Only the letters database is backed
  up; flutter_secure_storage's data (the draft) is left out because its
  Keystore key doesn't survive a restore (docs/ARCHITECTURE.md).
-->
<full-backup-content>
    <include domain="root" path="app_flutter/laternote.sqlite" />
</full-backup-content>
