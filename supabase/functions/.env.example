# Secrets for `supabase functions serve`. Copy to supabase/functions/.env
# (gitignored) and fill in. On hosted projects, set the same names with
# `supabase secrets set`. See docs/environments.md.

# Random string shared with the Vault secret `push_cron_secret`, e.g.
# `openssl rand -hex 32`. Only cron may call send-notifications.
PUSH_CRON_SECRET=

# The project's secret key (sb_secret_...). Local: `supabase status`.
SERVER_SECRET_KEY=

# Firebase service-account JSON on one line (Project settings → Service
# accounts → Generate new private key), e.g. `jq -c . key.json`.
FCM_SERVICE_ACCOUNT=
