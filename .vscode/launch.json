{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Laternote (development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--flavor",
        "development",
        "--dart-define-from-file=config/dev.json"
